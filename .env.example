# Copy to .env for local development. Everything is optional locally:
# without DATABASE_URL, Compass keeps its data in memory, seeded with the launch listings.

# Neon Postgres. Migrations run on deploy (see vercel.json).
DATABASE_URL=

# At least 32 random characters. Signs the sign-in cookie. Required in production.
SESSION_SECRET=

# Comma-separated email addresses that can moderate.
MODERATOR_EMAILS=

# Sends sign-in links. Without it, local runs show the link on the page instead.
RESEND_API_KEY=
EMAIL_FROM="Compass <compass@johndennehy.dev>"

# The public address, used in sign-in links. Defaults to the address of the request.
SITE_URL=

# Google Maps in the browser. Restrict this key to your domains (see the README).
VITE_GOOGLE_MAPS_API_KEY=
# A Map ID from Google Cloud for advanced markers. Defaults to Google's demo id.
VITE_GOOGLE_MAPS_MAP_ID=
